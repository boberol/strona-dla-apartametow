DATABASE_URL="file:./dev.db"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Leave STRIPE_SECRET_KEY empty to run checkout in simulated mode: choosing a
# plan activates it locally instead of taking a payment. Set it (plus the
# webhook secret) to switch to real Stripe with no code change.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Optional. Without these, checkout builds the price inline from src/lib/plans.ts.
STRIPE_PRICE_ONE_MONTHLY=""
STRIPE_PRICE_ONE_YEARLY=""
STRIPE_PRICE_COMPLEX_MONTHLY=""
STRIPE_PRICE_COMPLEX_YEARLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""

# Optional. Without RESEND_API_KEY, development prints emails (password reset
# links, guest report alerts) to the server console instead of sending them;
# production sends nothing and logs that it did not.
RESEND_API_KEY=""
EMAIL_FROM="StayGuide <hello@your-domain.com>"
